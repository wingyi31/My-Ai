APP_ENV=local
MYTIMES_BASE_URL=https://mytimes.taylors.edu.my
MYTIMES_TOKEN=
MOODLE_REQUEST_TIMEOUT_SECONDS=30
HTTP_TRUST_ENV=false
SCHEDULER_SHARED_SECRET=replace-with-a-long-random-value-for-local-testing

# Personal Canvas access key. The application makes GET requests only.
CANVAS_BASE_URL=https://canvas.nus.edu.sg
CANVAS_ACCESS_KEY=
CANVAS_REQUEST_TIMEOUT_SECONDS=30

# Create a Google OAuth 2.0 Web application and register the redirect URI below.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/gmail/oauth/callback
GMAIL_OAUTH_STATE_SECRET=replace-with-another-long-random-value
# Optional in production; local OAuth setup stores this in data/ instead.
GMAIL_REFRESH_TOKEN=
GMAIL_TOKEN_PATH=data/gmail_credentials.json
GMAIL_SYNC_STATE_PATH=data/gmail_sync_state.json
GMAIL_SYNC_QUERY=in:inbox
GMAIL_MAX_MESSAGES_PER_SYNC=50
GMAIL_REQUEST_TIMEOUT_SECONDS=30
